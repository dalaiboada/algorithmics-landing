---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import WhatsAppButton from "../components/WhatsAppButton.astro";

export interface Props {
  title?: string;
  lang?: string;
}

const { title = "Algorithmics", lang = "es" } = Astro.props;
const siteUrl = "https://algorithmics-landing-nine.vercel.app";
const currentUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = `${siteUrl}/img/og-algotithmics.jpg`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <!-- <meta property="og:description" content={t('dev.description')} /> -->
    <meta property="og:image" content={ogImageUrl} />
    
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <!-- <meta name="twitter:description" content={t('dev.description')} /> -->
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/img/algorithmics-logo.png" />
    <title>{title}</title>

    <ClientRouter />

    <script>
      (function() {
        var lang = localStorage.getItem("lang") || "es";
        document.documentElement.lang = lang;
      })();
    </script>
  </head>
  <body transition:animate="slide">
    <slot />
    <WhatsAppButton />
  </body>
</html>
