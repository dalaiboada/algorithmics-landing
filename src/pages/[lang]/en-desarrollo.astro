---
import Layout from "../../layouts/Layout.astro";
import { useTranslations, getLangFromUrl } from "../../config/i18n/utils";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "es" | "en");
const basePath = `/${lang}`;
---

<Layout title="En desarrollo — Algorithmics" lang={lang}>
  <div class="min-h-screen flex flex-col">
    <Navbar />

    <main class="flex-1 flex flex-col items-center px-6 pt-2 pb-8">
      <div class="text-center max-w-lg w-full flex flex-col items-center">
        
        <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

        <div class="w-48 h-48 md:w-64 md:h-64 mb-2 relative">
          <model-viewer 
            src="/models/Hardhat.glb" 
            alt="Un modelo 3D de un casco de obra"
            auto-rotate 
            rotation-per-second="45deg" 
            camera-controls 
            camera-orbit="45deg 75deg auto"
            touch-action="pan-y"
            exposure="0.5"
            interaction-prompt="none"
            shadow-intensity="0.5"
            style="width: 100%; height: 100%; background-color: transparent;"
          >
          </model-viewer>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-neutral-800 mb-3" data-i18n="section_under_construction">{t("section_under_construction")}</h1>
        <p class="text-base md:text-lg text-neutral-500 mb-6" data-i18n="section_coming_soon">
          {t("section_coming_soon")}
        </p>
        <a
          href={basePath}
          class="btn btn-primary mb-10"
          data-i18n="buttons.back_to_top"
        >
          {t("buttons.back_to_top")}
        </a>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
