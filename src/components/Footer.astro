---
import { siteConfig } from "../config/site"
import { getLangFromUrl, useTranslations } from "../config/i18n/utils"
import Icon from "./Icon.astro";

const language = getLangFromUrl(Astro.url);
const t = useTranslations(language);
const basePath = `/${language}`;
---

<footer class="text-white" style="background-color: #6329a1" transition:name="footer">
  <div class="container mx-auto max-w-6xl px-6 py-16">
    <div class="grid md:grid-cols-4 gap-10">
      <div class="md:col-span-1">
        <a href={basePath}>
          <img
            src="/img/algorithmics-logo_largo.png"
            alt="Algorithmics"
            class="h-8 w-auto brightness-0 invert mb-4"
          />
        </a>
        <p class="text-sm text-primary-200 leading-relaxed">
          {siteConfig.description}
        </p>
        <div class="flex gap-4 mt-6">
          {
            siteConfig.socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-white transition-colors" aria-label={social.name}>
                {social.icon === "facebook" && (
                  <Icon name="facebook" class="h-5 w-5" />
                )}
                {social.icon === "instagram" && (
                  <Icon name="instagram" class="h-5 w-5" />
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider" data-i18n="footer.navigation">
          {t('footer.navigation')}
        </h4>
        <ul class="space-y-3 text-sm">
          <li><a href={basePath + "#features"} class="hover:text-white transition-colors" data-i18n="nav.about">{t('nav.about')}</a></li>
          <li><a href={basePath + "#courses"} class="hover:text-white transition-colors" data-i18n="nav.courses">{t('nav.courses')}</a></li>
          <li><a href={basePath + "#testimonials"} class="hover:text-white transition-colors" data-i18n="nav.testimonials">{t('nav.testimonials')}</a></li>
          <li><a href={basePath + "#contact"} class="hover:text-white transition-colors" data-i18n="nav.contact">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider" data-i18n="footer.courses">
          {t('footer.courses')}
        </h4>
        <ul class="space-y-3 text-sm">
          <li><a href={basePath + "/en-desarrollo"} class="hover:text-white transition-colors" data-i18n="footer.fullstack" data-i18n-href="/en-desarrollo">{t('footer.fullstack')}</a></li>
          <li><a href={basePath + "/en-desarrollo"} class="hover:text-white transition-colors" data-i18n="footer.datascience" data-i18n-href="/en-desarrollo">{t('footer.datascience')}</a></li>
          <li><a href={basePath + "/en-desarrollo"} class="hover:text-white transition-colors" data-i18n="footer.uxui" data-i18n-href="/en-desarrollo">{t('footer.uxui')}</a></li>
          <li><a href={basePath + "/en-desarrollo"} class="hover:text-white transition-colors" data-i18n="footer.view_all" data-i18n-href="/en-desarrollo">{t('footer.view_all')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider" data-i18n="footer.contact">
          {t('footer.contact')}
        </h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <Icon name="email" class="h-4 w-4 mt-0.5 shrink-0 text-primary-400" />
            <span class="text-primary-200">{siteConfig.contact.email}</span>
          </li>

          <li class="flex items-start gap-2">
            <Icon name="whatsapp" class="h-4 w-4 mt-0.5 shrink-0 text-primary-400" />
            <span class="text-primary-200">{siteConfig.contact.phone}</span>
          </li>

          <li class="flex items-start gap-2">
            <Icon name="location" class="h-4 w-4 mt-0.5 shrink-0 text-primary-400" />
            <span class="text-primary-200">{siteConfig.contact.address}</span>
          </li>

          <li class="flex items-start gap-2">
            <Icon name="clock" class="h-4 w-4 mt-0.5 shrink-0 text-primary-400" />
            <div class="text-primary-200">
              <p>{siteConfig.contact.schedule}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-primary-700 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-primary-300">
      <p>&copy; {new Date().getFullYear()} Algorithmics. <span data-i18n="footer.rights">{t('footer.rights')}</span></p>
      <div class="flex gap-6">
        <a href={basePath + "/aviso-de-privacidad"} class="hover:text-white transition-colors" data-i18n="footer.privacy_policy" data-i18n-href="/aviso-de-privacidad">{t('footer.privacy_policy')}</a>
        <a href={basePath + "/terminos-y-condiciones"} class="hover:text-white transition-colors" data-i18n="footer.terms_of_service" data-i18n-href="/terminos-y-condiciones">{t('footer.terms_of_service')}</a>
      </div>
    </div>
  </div>
</footer>
