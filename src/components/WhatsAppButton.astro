---
import { siteConfig } from "../config/site";
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../config/i18n/utils";

const phone = siteConfig.contact.phone.replace(/[\s\-]/g, "");
const waUrl = `https://wa.me/${phone}`;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<style>
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    70% { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  .wa-ring {
    animation: wa-pulse 2.5s infinite;
  }
</style>

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-6 right-6 z-50 flex items-center gap-3"
  aria-label="WhatsApp"
>
  <span
    class="whitespace-nowrap rounded-full bg-white px-4 py-2 text-sm font-medium text-neutral-700 shadow-md opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 translate-x-4"
    data-i18n="contact.contact-us"
  >
    {t("contact.contact-us")}
  </span>
  <span
    class="wa-ring flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-[#25D366] to-[#128C7E] text-white shadow-lg transition-all duration-300 hover:scale-110 hover:shadow-xl hover:shadow-green-500/30"
  >
    <Icon name="whatsapp-brand" class="h-8 w-8" />
  </span>
</a>

